# Porta interna do Node (no Docker, o Caddy fica na frente).
PORT=3000

# Domínio público do site. Com um domínio apontado para a VPS, o Caddy gera HTTPS sozinho.
# Sem domínio, deixe ":80" e acesse pelo IP da VPS (http://IP).
SITE_ADDRESS=:80

# Banco de dados. "mongo" é o serviço do docker-compose.
# Rodando sem Docker, use mongodb://localhost:27017/acolhe ou a string do MongoDB Atlas.
MONGODB_URI=mongodb://mongo:27017/acolhe

# Chave para assinar os logins. Gere uma com: openssl rand -hex 32
JWT_SECRET=troque-por-uma-chave-longa-e-segura-com-32-caracteres-ou-mais

# Cria os anúncios de exemplo e a conta demo@acolhe.local na primeira subida.
SEED_DEMO_DATA=true

# Pasta onde ficam as fotos enviadas pelos usuários.
UPLOADS_DIR=uploads
